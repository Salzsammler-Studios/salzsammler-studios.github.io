---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Salzsammler from "../components/projekte/salzsammler.astro";
import Derschalter from "../components/projekte/derschalter.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Projekte – Salzsammler Studios">
    <Nav />
    <Hero line1="Ein Portfolio, das beeindruckt" variant="half" />
    <Salzsammler />
    <Derschalter />
    <div class="bg-secondary rounded-3xl mx-auto m-20 p-10 w-[50vw]">
        <h1 class="text-heading text-black pb-5">
            Du willst auch sowas geiles?
        </h1>
        <div class="flex justify-center">
            <Button href="/kontakt" label="Let's Talk" variant="secondary" />
        </div>
    </div>
    <Footer />
</Layout>
