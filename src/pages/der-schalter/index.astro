---
import Layout from "../../layouts/Layout.astro";

const APP_STORE_URL = "#";
const PLAY_STORE_URL = "#";
---

<Layout title="Der Schalter – App herunterladen">
    <main class="min-h-screen flex items-center px-6 py-20">
        <section
            class="bg-tertiary rounded-3xl py-12 md:py-20 px-8 md:px-16 w-full max-w-5xl mx-auto"
        >
            <h1 class="text-heading">Der Schalter</h1>
            <p class="font-heading font-bold text-lg text-secondary mt-1 mb-8">
                Sparkasse erleben.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
                <div>
                    <p class="text-body-dark mb-8">
                        Lade dir <em>Der Schalter</em> jetzt kostenlos herunter
                        und erlebe die Geschichte der Sparkasse Selb spielerisch
                        auf deinem Smartphone.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a
                            href={APP_STORE_URL}
                            class="inline-flex items-center gap-3 bg-primary text-white rounded-xl px-5 py-3.5 hover:opacity-80 transition-opacity w-fit"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="22"
                                height="22"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
                                ></path>
                            </svg>
                            <div class="leading-tight font-heading">
                                <p class="text-[10px] opacity-70">Laden im</p>
                                <p class="text-sm font-semibold">App Store</p>
                            </div>
                        </a>
                        <a
                            href={PLAY_STORE_URL}
                            class="inline-flex items-center gap-3 bg-primary text-white rounded-xl px-5 py-3.5 hover:opacity-80 transition-opacity w-fit"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="22"
                                height="22"
                                fill="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    d="M3.18 23.76c.31.17.66.24 1.01.2l12.5-12.5-3.54-3.54-9.97 15.84zm16.4-9.93L16.73 12l2.85-1.83L5.49.6c-.48-.29-1.01-.37-1.5-.25l10.18 10.16 5.41 3.32zM1.75 1.73C1.45 2.07 1.25 2.57 1.25 3.2v17.6c0 .63.2 1.13.5 1.47l.08.07L10.5 13.66v-.26L1.75 1.73zm17.43 8.04l-2.68-1.63-3.54 3.54 3.54 3.54 2.68-1.63c.77-.47.77-1.35 0-1.82z"
                                ></path>
                            </svg>
                            <div class="leading-tight font-heading">
                                <p class="text-[10px] opacity-70">Jetzt bei</p>
                                <p class="text-sm font-semibold">Google Play</p>
                            </div>
                        </a>
                    </div>
                </div>
                <div
                    class="flex flex-row items-end justify-center md:justify-end gap-8 pb-6"
                >
                    <img
                        src="/images/projects/ds-screenshot-1.png"
                        alt="Der Schalter – App Screenshot"
                        class="w-[28vw] max-w-[140px] md:w-1/2 md:max-w-[200px] h-auto object-contain drop-shadow-xl"
                        loading="lazy"
                        draggable="false"
                    />
                    <img
                        src="/images/projects/ds-screenshot-2.png"
                        alt="Der Schalter – App Screenshot"
                        class="w-[28vw] max-w-[140px] md:w-1/2 md:max-w-[200px] h-auto object-contain drop-shadow-xl"
                        loading="lazy"
                        draggable="false"
                    />
                </div>
            </div>
        </section>
    </main>
</Layout>
