---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TeamCard from "../components/kontakt/TeamCard.astro";
import Footer from "../components/Footer.astro";

const members = [
    {
        image: "/images/team/tina.png",
        name: "Nic Schilling",
        role: "Creative Direction",
        backTitle: "Co-Founder",
        backBody:
            "Konzeption, Design und Projektleitung. Nic sorgt dafür, dass aus Ideen echte Erlebnisse werden.",
    },
    {
        image: "/images/team/tina.png",
        name: "Ruben Schäfer",
        role: "Technology",
        backTitle: "Co-Founder",
        backBody:
            "Entwicklung und technische Umsetzung. Ruben baut die Systeme, die unsere Installationen zum Leben erwecken.",
    },
    {
        image: "/images/team/tina.png",
        name: "Tina Wolfrum",
        role: "Artist",
        backTitle: "Artist",
        backBody:
            "Tina ist unsere Künstlerin und verantwortet das gesamte visuelle Erscheinungsbild unserer Projekte. Von Charakteren und Illustrationen bis hin zu vollständigen Spielwelten.",
    },
];
---

<Layout title="Team – Salzsammler Studios">
    <Nav />
    <Hero line1="Wir sind" line2="Salzsammler" />
    <main class="h-[90dvh] px-6 py-24">
        <div class="flex flex-row flex-wrap justify-center gap-16">
            {
                members.map((m) => (
                    <TeamCard
                        image={m.image}
                        name={m.name}
                        role={m.role}
                        backTitle={m.backTitle}
                        backBody={m.backBody}
                    />
                ))
            }
        </div>
    </main>
    <Footer />
</Layout>
