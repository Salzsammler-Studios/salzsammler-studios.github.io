---
interface Props {
    icon: string;
    iconDark?: string;
    title: string;
    body: string;
    delay?: number;
}

const { icon, iconDark, title, body, delay } = Astro.props;
---

<div
    class="[perspective:1000px] w-full h-64 md:h-90 cursor-pointer select-none"
    data-flip-card
    data-fade
    data-fade-delay={delay ?? 0}
>
    <div
        class="flip-inner relative w-full h-full transition-transform duration-500 ease-in-out [transform-style:preserve-3d]"
    >
        <!-- Front -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] bg-primary rounded-2xl p-6 flex flex-col justify-between"
        >
            <img src={icon} alt="" class="w-16 h-16 object-contain" />
            <h1 class="text-subheading font-medium text-2xl text-text-light">
                {title}
            </h1>
        </div>

        <!-- Back -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)] bg-secondary rounded-2xl p-6 flex flex-col justify-between"
        >
            <img src={iconDark ?? icon} alt="" class="w-16 h-16 object-contain" />
            <p class="text-body text-black">{body}</p>
        </div>
    </div>
</div>

<style>
    /* Hover flip for pointer (mouse) devices */
    @media (hover: hover) and (pointer: fine) {
        [data-flip-card]:hover .flip-inner {
            transform: rotateY(180deg);
        }
    }

    /* Click/tap flip toggled via JS */
    .flip-inner.is-flipped {
        transform: rotateY(180deg);
    }
</style>

<script>
    function initFlipCards() {
        document.querySelectorAll("[data-flip-card]").forEach((card) => {
            // Avoid double-binding after view transitions
            if (card.dataset.flipBound) return;
            card.dataset.flipBound = "true";

            const inner = card.querySelector(".flip-inner");
            if (!inner) return;

            card.addEventListener("click", () => {
                inner.classList.toggle("is-flipped");
            });
        });
    }

    // Initial load
    initFlipCards();
    // Re-run after Astro view transitions swap the page
    document.addEventListener("astro:page-load", initFlipCards);
</script>
