---
const links = [
    { label: "Projekte", href: "/projekte" },
    { label: "Kontakt", href: "/kontakt" },
];
const pathname = Astro.url.pathname;
---

<nav
    class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4"
>
    <a
        href="/"
        class:list={[
            "text-sm font-semibold tracking-widest uppercase",
            pathname === "/" ? "text-white" : "text-black mix-blend-difference",
        ]}
        data-nav-item
        {...pathname === "/" ? { "data-nav-active": true } : {}}
    >
        salzsammler
    </a>
    <ul class="flex gap-8">
        {
            links.map((l) => (
                <li>
                    <a
                        href={l.href}
                        class:list={[
                            "text-sm tracking-wide hover:opacity-70 transition-opacity",
                            pathname.startsWith(l.href)
                                ? "text-white"
                                : "text-black mix-blend-difference",
                        ]}
                        data-nav-item
                        {...(pathname.startsWith(l.href)
                            ? { "data-nav-active": true }
                            : {})}
                    >
                        {l.label}
                    </a>
                </li>
            ))
        }
    </ul>
    <div class="text-white text-sm tracking-wide mix-blend-difference">
        <a href="/de" class="font-semibold">DE</a>
        <span class="mx-1 opacity-50">|</span>
        <a href="/en" class="opacity-70 hover:opacity-100 transition-opacity"
            >ENG</a
        >
    </div>
</nav>
