---
import WorkflowCard from "./WorkflowCard.astro";

const steps = [
    {
        number: "01",
        title: "Das Thema",
        body: "Alles beginnt mit Ihrem Inhalt: einem Exponat, einer Epoche, einer Geschichte, die bisher nur auf Texttafel existiert.",
    },
    {
        number: "02",
        title: "Die Frage",
        body: "Wir analysieren das Narrativ und entwickeln das passende interaktive Konzept.",
    },
    {
        number: "03",
        title: "Das Erlebnis",
        body: "Wir bauen eine maßgeschneiderte XR-Installation, die Besucher nicht informiert, sondern mitnimmt.",
    },
];
---

<section class="bg-tertiary h-auto md:h-[90dvh] rounded-3xl px-6 md:px-30 pt-10 md:pt-20 pb-10 md:pb-0">
    <h2 class="text-heading text-center mb-10">Der Ansatz</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
            steps.map((step) => (
                <WorkflowCard
                    number={step.number}
                    title={step.title}
                    body={step.body}
                />
            ))
        }
    </div>
</section>
