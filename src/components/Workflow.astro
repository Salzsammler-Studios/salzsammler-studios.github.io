---
const steps = [
    {
        number: "01",
        title: "Das Thema",
        description:
            "Alles beginnt mit Ihrem Inhalt: einem Exponat, einer Epoche, einer Geschichte, die bisher nur auf Texttafel existiert.",
    },
    {
        number: "02",
        title: "Die Frage",
        description:
            "Wie kann man das erleben – nicht nur lesen? Wir analysieren das Narrativ und entwickeln das passende interaktive Konzept.",
    },
    {
        number: "03",
        title: "Das Erlebnis",
        description:
            "Wir bauen eine maßgeschneiderte XR-Installation, die Besucher nicht informiert, sondern mitnimmt.",
    },
];
---

<section class="bg-secondary px-8 py-16">
    <h2
        class="font-poppins font-semibold text-primary text-4xl leading-tight mb-16"
    >
        Vom Thema<br />zum Erlebnis
    </h2>

    <div class="grid grid-cols-3 gap-8">
        {
            steps.map((step) => (
                <div>
                    <p class="font-anybody font-black text-7xl text-primary/25 mb-4 leading-none">
                        {step.number}
                    </p>
                    <div class="border-l-4 border-primary pl-3">
                        <h3 class="font-poppins font-bold text-lg mb-3">
                            {step.title}
                        </h3>
                        <p class="text-stone-500 text-sm leading-relaxed max-w-[300px]">
                            {step.description}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</section>
