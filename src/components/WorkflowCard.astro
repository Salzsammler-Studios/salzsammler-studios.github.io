---
interface Props {
    number: string;
    title: string;
    body: string;
}

const { number, title, body } = Astro.props;
---

<div class="[perspective:1000px] h-90 w-70">
    <div
        class="relative w-full h-full transition-transform duration-500 ease-in-out [transform-style:preserve-3d] hover:[transform:rotateY(180deg)]"
    >
        <!-- Front -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] bg-stone-200 rounded-2xl p-6 flex flex-col justify-between"
        >
            <span
                class="font-heading font-bold text-5xl text-primary/30 leading-none"
            >
                {number}
            </span>
            <h3 class="text-subheading font-bold text-stone-800">{title}</h3>
        </div>

        <!-- Back -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)] bg-primary rounded-2xl p-6 flex flex-col justify-between"
        >
            <span
                class="font-heading font-bold text-5xl text-white/30 leading-none"
            >
                {number}
            </span>
            <p class="text-body text-white/90">{body}</p>
        </div>
    </div>
</div>
