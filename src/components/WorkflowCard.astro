---
interface Props {
    number: string;
    title: string;
    body: string;
}

const { number, title, body } = Astro.props;
---

<div class="[perspective:1000px] h-90 w-70">
    <div
        class="relative w-full h-full transition-transform duration-500 ease-in-out [transform-style:preserve-3d] hover:[transform:rotateY(180deg)]"
    >
        <!-- Front -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] bg-primary rounded-2xl p-6 flex flex-col justify-between"
        >
            <span
                class="font-body font-bold text-5xl text-secondary leading-none"
            >
                {number}
            </span>
            <h1 class="text-subheading font-medium text-2xl text-text-light">
                {title}
            </h1>
        </div>

        <!-- Back -->
        <div
            class="absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)] bg-secondary rounded-2xl p-6 flex flex-col justify-between"
        >
            <span
                class="font-heading font-bold text-5xl text-primary leading-none"
            >
                {number}
            </span>
            <p class="text-body text-black">{body}</p>
        </div>
    </div>
</div>
