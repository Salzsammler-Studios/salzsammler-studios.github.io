---
const links = [
    { label: "Projekte", href: "/projekte" },
    { label: "Kontakt", href: "/kontakt" },
    { label: "Team", href: "/team" },
    { label: "Impressum", href: "/impressum" },
    { label: "Datenschutz", href: "/data-privacy" },
];
---

<footer
    class="flex bg-primary items-center justify-between px-10 py-8 mt-6 rounded-tl-3xl rounded-tr-3xl"
>
    <a
        href="/"
        class="font-heading font-bold text-sm tracking-widest uppercase text-text-light"
    >
        salzsammler
    </a>

    <ul class="flex flex-col gap-0 text-right">
        {
            links.map((l) => (
                <ul>
                    <a
                        href={l.href}
                        class="text-body text-text-light hover:text-stone-900 transition-colors"
                    >
                        {l.label}
                    </a>
                </ul>
            ))
        }
    </ul>
</footer>
