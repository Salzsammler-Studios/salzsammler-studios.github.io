---
interface Props {
    label: string;
    href?: string;
    variant?: "primary" | "outline" | "ghost";
    type?: "button" | "submit";
}

const { label, href, variant = "primary", type = "button" } = Astro.props;

const base =
    "inline-block px-6 py-3 text-sm font-semibold rounded-xl transition-opacity hover:opacity-80 cursor-pointer";

const variants = {
    primary: "bg-primary text-white",
    outline: "border-2 border-primary text-primary",
    ghost: "text-primary underline underline-offset-4",
};

const classes = `${base} ${variants[variant]}`;
---

{
    href ? (
        <a href={href} class={classes}>
            {label}
        </a>
    ) : (
        <button type={type} class={classes}>
            {label}
        </button>
    )
}
