<canvas id="cursor-trail" class="fixed inset-0 pointer-events-none z-[9999]"
></canvas>

<script>
    const canvas = document.getElementById("cursor-trail") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d")!;

    const NODES = 10;
    const LERP = 0.8;
    const MAX_WIDTH = 10;

    let mouse = { x: -999, y: -999 };
    let nodes = Array.from({ length: NODES }, () => ({ x: -999, y: -999 }));
    let rafId: number;
    let r = 0,
        g = 0,
        b = 0;

    function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }

    function parseColor() {
        const hex = getComputedStyle(document.documentElement)
            .getPropertyValue("--color-primary")
            .trim();
        r = parseInt(hex.slice(1, 3), 16);
        g = parseInt(hex.slice(3, 5), 16);
        b = parseInt(hex.slice(5, 7), 16);
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Head follows mouse
        nodes[0].x += (mouse.x - nodes[0].x) * LERP;
        nodes[0].y += (mouse.y - nodes[0].y) * LERP;

        // Each node follows the one ahead
        for (let i = 1; i < NODES; i++) {
            nodes[i].x += (nodes[i - 1].x - nodes[i].x) * LERP;
            nodes[i].y += (nodes[i - 1].y - nodes[i].y) * LERP;
        }

        // Gradient from head (opaque) to tail (transparent)
        const tail = nodes[NODES - 1];
        const head = nodes[0];
        const grad = ctx.createLinearGradient(head.x, head.y, tail.x, tail.y);
        grad.addColorStop(0, `rgba(${r},${g},${b},0.85)`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);

        // Single smooth bezier path through all nodes
        ctx.beginPath();
        ctx.moveTo(head.x, head.y);
        for (let i = 0; i < NODES - 2; i++) {
            const mx = (nodes[i].x + nodes[i + 1].x) / 2;
            const my = (nodes[i].y + nodes[i + 1].y) / 2;
            ctx.quadraticCurveTo(nodes[i].x, nodes[i].y, mx, my);
        }
        ctx.lineTo(tail.x, tail.y);

        ctx.lineWidth = MAX_WIDTH;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
        ctx.strokeStyle = grad;
        ctx.stroke();

        // Small dot directly under the mouse
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, 5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r},${g},${b},0.85)`;
        ctx.fill();

        rafId = requestAnimationFrame(animate);
    }

    function init() {
        resize();
        parseColor();
        nodes = Array.from({ length: NODES }, () => ({ x: -999, y: -999 }));
        cancelAnimationFrame(rafId);
        animate();
    }

    window.addEventListener("resize", resize);
    window.addEventListener("mousemove", (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
    });
    document.addEventListener("astro:after-swap", init);
    init();
</script>
