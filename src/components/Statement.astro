---
import StatementCard from "./StatementCard.astro";
import Button from "./Button.astro";
---

<section class="relative h-auto md:h-[90dvh] overflow-hidden">
    <div
        class="grid grid-cols-1 md:grid-cols-2 gap-4 py-10 md:py-20 px-6 md:px-20"
    >
        <div>
            <h1 class="text-heading pb-6">
                Wissen vermitteln ist gut.<br />Wissen <span class="font-light"
                    >erleben</span
                > ist besser.
            </h1>
            <p class="text-body-dark pb-20">
                Texttafeln und Vitrinen haben ihren Platz, <br />
                aber die Besucherinnen und Besucher von morgen<br />
                erwarten mehr.
            </p>
            <Button href="/projekte" label="Unsere Projekte" />
        </div>
        <div class="grid grid-cols-1 gap-4 ml-0 md:ml-30">
            <StatementCard
                title="Individuell konzipiert"
                text="Wir entwickeln jede Installation von Grund auf neu. Passend zu Ihrem Raum, Ihren Inhalten und Ihrem Publikum."
            >
                <img
                    class="w-full h-full object-contain"
                    src="/icons/Idea.png"
                    alt="An Image of a Lightbulb"
                />
            </StatementCard>
            <StatementCard
                title="Didaktische Tiefe"
                text="Unser Team verbindet technisches Know-how mit pädagogischer Kompetenz."
            >
                <img
                    class="w-full h-full object-contain"
                    src="/icons/Idea.png"
                    alt="An Image of a Lightbulb"
                />
            </StatementCard>
            <StatementCard
                title="Mit Ihnen gedacht"
                text="Die besten Erlebnisse entstehen, wo Ihr Fachwissen und unsere Gestaltungserfahrung aufeinandertreffen."
            >
                <img
                    class="w-full h-full object-contain"
                    src="/icons/Idea.png"
                    alt="An Image of a Lightbulb"
                />
            </StatementCard>
        </div>
    </div>
</section>
