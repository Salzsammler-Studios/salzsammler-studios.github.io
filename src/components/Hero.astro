---
import LightRays from "./LightRays.jsx";

interface Props {
    line1: string;
    line2?: string;
    variant?: "full" | "half";
}

const { line1, line2, variant = "full" } = Astro.props;

const heightClass = variant === "half" ? "h-[50dvh]" : "h-[90dvh]";
---

<section
    class={`relative ${heightClass} bg-primary mx-6 mt-6 rounded-3xl overflow-hidden animate-hero-reveal`}
>
    <!-- Light rays overlay -->
    <div class="absolute inset-0">
        <LightRays
            client:load
            raysOrigin="top-right"
            raysColor="#627CFF"
            raysSpeed={0.8}
            lightSpread={0.6}
            rayLength={4}
            fadeDistance={6}
            followMouse={true}
            mouseInfluence={0.2}
            noiseAmount={0.05}
            distortion={0}
            pulsating={false}
        />
    </div>

    <!-- Main headline -->
    <div class="absolute bottom-10 right-0 left-0 px-6 z-10 animate-hero-text">
        <h1 class="text-display">
            <span class="block text-display">{line1}</span>
            {line2 && <span class="block text-display">{line2}</span>}
        </h1>
    </div>
</section>

<style>
    /* Section wipes in from top to bottom */
    @keyframes hero-reveal {
        from {
            clip-path: inset(0 0 100% 0 round 1.5rem);
        }
        to {
            clip-path: inset(0 0 0% 0 round 1.5rem);
        }
    }

    /* Text fades up after the reveal */
    @keyframes hero-text {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-hero-reveal {
        animation: hero-reveal 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .animate-hero-text {
        opacity: 0;
        animation: hero-text 0.6s ease-out 0.7s forwards;
    }
</style>
