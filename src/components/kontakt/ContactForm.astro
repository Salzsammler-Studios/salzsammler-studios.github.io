<form id="contact-form" class="w-full flex flex-col gap-5">
    <!-- Honeypot: hidden from humans, bots fill it in -->
    <input
        type="text"
        name="website"
        id="website"
        tabindex="-1"
        autocomplete="off"
        style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;"
    />
    <!-- Timestamp for timing check -->
    <input type="hidden" name="_t" id="_t" />

    <div class="flex flex-col gap-1">
        <label for="name" class="pl-2 text-label text-black/60">Ihr Name</label>
        <input
            type="text"
            id="name"
            name="name"
            required
            class="bg-tertiary text-black placeholder:text-black/30 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition"
            placeholder="Max Mustermann"
        />
    </div>

    <div class="flex flex-col gap-1">
        <label for="email" class="pl-2 text-label text-black/60"
            >Ihre E-Mail</label
        >
        <input
            type="email"
            id="email"
            name="email"
            required
            class="bg-tertiary text-black placeholder:text-black/30 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition"
            placeholder="max@example.de"
        />
    </div>

    <div class="flex flex-col gap-1">
        <label for="message" class="pl-2 text-label text-black/60"
            >Ihre Nachricht</label
        >
        <textarea
            id="message"
            name="message"
            required
            rows="7"
            class="bg-tertiary text-black placeholder:text-black/30 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition resize-none"
            placeholder="Erzählen Sie uns von Ihrem Projekt…"></textarea>
        <p class="text-xs text-black/40 mt-1">
            Detaillierte Informationen zum Umgang mit Nutzerdaten finden Sie in
            unserer
            <a href="/data-privacy" class="text-secondary hover:underline"
                >Datenschutzerklärung</a
            >.
        </p>
    </div>

    <div class="flex justify-end">
        <button
            type="submit"
            id="submit-btn"
            class="bg-secondary text-white font-semibold text-sm rounded-xl px-8 py-3 hover:opacity-80 transition-all duration-300 disabled:opacity-50"
        >
            Anfrage senden
        </button>
    </div>
</form>

<!-- Toast notification -->
<div
    id="toast"
    role="alert"
    aria-live="polite"
    class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-xl px-5 py-4 shadow-xl text-sm font-semibold text-white max-w-xs pointer-events-none"
    style="opacity:0;transform:translateY(1rem);"
>
    <span id="toast-icon"></span>
    <span id="toast-message"></span>
</div>

<style>
    #toast {
        transition:
            opacity 0.3s ease,
            transform 0.3s ease;
    }
    #toast.toast-show {
        opacity: 1 !important;
        transform: translateY(0) !important;
        pointer-events: auto !important;
    }
    #toast.toast-success {
        background-color: #16a34a;
    }
    #toast.toast-error {
        background-color: #ef4444;
    }
    #submit-btn.btn-success {
        background-color: #16a34a;
    }
</style>

<script>
    const tField = document.getElementById("_t") as HTMLInputElement | null;
    if (tField) tField.value = String(Math.floor(Date.now() / 1000));

    const form = document.getElementById(
        "contact-form",
    ) as HTMLFormElement | null;
    const btn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement | null;
    const toast = document.getElementById("toast")!;
    const toastIcon = document.getElementById("toast-icon")!;
    const toastMessage = document.getElementById("toast-message")!;

    const ENDPOINT = "https://www.salzsammler.de/contact.php";

    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    function showToast(message: string, success: boolean) {
        if (toastTimer) clearTimeout(toastTimer);
        toast.classList.remove("toast-success", "toast-error", "toast-show");
        // force reflow so re-showing animates fresh
        void toast.offsetWidth;
        toast.classList.add(success ? "toast-success" : "toast-error", "toast-show");
        toastIcon.textContent = success ? "✓" : "✕";
        toastMessage.textContent = message;
        toastTimer = setTimeout(() => toast.classList.remove("toast-show"), 4000);
    }

    function resetBtn() {
        if (!btn) return;
        btn.disabled = false;
        btn.textContent = "Anfrage senden";
        btn.classList.remove("btn-success");
    }

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form || !btn) return;

        btn.disabled = true;
        btn.textContent = "Wird gesendet…";

        const payload = {
            website: (form.elements.namedItem("website") as HTMLInputElement)
                .value,
            _t: (form.elements.namedItem("_t") as HTMLInputElement).value,
            name: (form.elements.namedItem("name") as HTMLInputElement).value,
            email: (form.elements.namedItem("email") as HTMLInputElement).value,
            message: (
                form.elements.namedItem("message") as HTMLTextAreaElement
            ).value,
        };

        try {
            const res = await fetch(ENDPOINT, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });

            const json = await res.json();

            if (res.ok && json.success) {
                form.reset();
                if (tField)
                    tField.value = String(Math.floor(Date.now() / 1000));
                btn.disabled = false;
                btn.textContent = "✓ Gesendet";
                btn.classList.add("btn-success");
                setTimeout(resetBtn, 2000);
                showToast(
                    "Ihre Nachricht wurde gesendet. Wir melden uns bald!",
                    true,
                );
            } else {
                resetBtn();
                showToast(json.error ?? "Ein Fehler ist aufgetreten.", false);
            }
        } catch {
            resetBtn();
            showToast(
                "Verbindungsfehler. Bitte versuchen Sie es erneut.",
                false,
            );
        }
    });
</script>
