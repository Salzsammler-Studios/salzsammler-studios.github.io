<form
    id="contact-form"
    class="w-full max-w-xl bg-primary rounded-3xl px-8 py-10 flex flex-col gap-5 mt-8"
>
    <!-- Honeypot: hidden from humans, bots fill it in -->
    <input
        type="text"
        name="website"
        id="website"
        tabindex="-1"
        autocomplete="off"
        style="position:absolute;opacity:0;height:0;width:0;pointer-events:none;"
    />
    <!-- Timestamp for timing check -->
    <input type="hidden" name="_t" id="_t" />

    <div class="flex flex-col gap-1">
        <label for="name" class="text-label text-text-light/60">Name</label>
        <input
            type="text"
            id="name"
            name="name"
            required
            class="bg-white/10 text-text-light placeholder:text-text-light/40 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition"
            placeholder="Max Mustermann"
        />
    </div>

    <div class="flex flex-col gap-1">
        <label for="email" class="text-label text-text-light/60">E-Mail</label>
        <input
            type="email"
            id="email"
            name="email"
            required
            class="bg-white/10 text-text-light placeholder:text-text-light/40 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition"
            placeholder="max@example.de"
        />
    </div>

    <div class="flex flex-col gap-1">
        <label for="message" class="text-label text-text-light/60">Nachricht</label>
        <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="bg-white/10 text-text-light placeholder:text-text-light/40 rounded-xl px-4 py-3 text-sm outline-none focus:ring-2 focus:ring-secondary transition resize-none"
            placeholder="Erzählen Sie uns von Ihrem Projekt…"
        ></textarea>
    </div>

    <button
        type="submit"
        id="submit-btn"
        class="bg-secondary text-primary font-semibold text-sm rounded-xl px-6 py-3 hover:opacity-80 transition-opacity disabled:opacity-50 self-start"
    >
        Nachricht senden
    </button>

    <p id="form-status" class="text-sm hidden"></p>
</form>

<script>
    const tField = document.getElementById('_t') as HTMLInputElement | null;
    if (tField) tField.value = String(Math.floor(Date.now() / 1000));

    const form   = document.getElementById('contact-form') as HTMLFormElement | null;
    const btn    = document.getElementById('submit-btn')   as HTMLButtonElement | null;
    const status = document.getElementById('form-status')  as HTMLElement | null;

    const ENDPOINT = 'https://YOUR_NETCUP_DOMAIN/contact.php'; // ← swap this

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form || !btn || !status) return;

        btn.disabled = true;
        btn.textContent = 'Wird gesendet…';
        status.className = 'text-sm hidden';

        const payload = {
            website: (form.elements.namedItem('website') as HTMLInputElement).value,
            _t:      (form.elements.namedItem('_t')      as HTMLInputElement).value,
            name:    (form.elements.namedItem('name')    as HTMLInputElement).value,
            email:   (form.elements.namedItem('email')   as HTMLInputElement).value,
            message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
        };

        try {
            const res = await fetch(ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const json = await res.json();

            if (res.ok && json.success) {
                form.reset();
                if (tField) tField.value = String(Math.floor(Date.now() / 1000));
                status.textContent = 'Ihre Nachricht wurde gesendet. Wir melden uns bald!';
                status.className = 'text-sm text-secondary';
            } else {
                status.textContent = json.error ?? 'Ein Fehler ist aufgetreten.';
                status.className = 'text-sm text-red-400';
            }
        } catch {
            status.textContent = 'Verbindungsfehler. Bitte versuchen Sie es erneut.';
            status.className = 'text-sm text-red-400';
        } finally {
            btn.disabled = false;
            btn.textContent = 'Nachricht senden';
            status.classList.remove('hidden');
        }
    });
</script>
